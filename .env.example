# Copy this file to .env and fill in your real values.
# See SETUP.md for step-by-step instructions on getting these.

# Your Neon Postgres connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Your Gemini API key from Google AI Studio
GEMINI_API_KEY=

# Which Gemini model to try first. If it's unavailable for your account,
# the app automatically tries a few current fallbacks (see
# FALLBACK_MODELS in core/ai_classifier.py) — you usually won't need
# to change this. If you do get a 404, check
# https://ai.google.dev/gemini-api/docs/models for a current model name.
GEMINI_MODEL=gemini-3.5-flash-lite

# Max requests per minute the pipeline will send. Keep this a bit under
# your model's actual free-tier RPM limit (check
# https://ai.google.dev/gemini-api/docs/rate-limits) to avoid 429 errors.
GEMINI_RPM=12

# Optional: tune anomaly detection sensitivity (defaults shown)
SPIKE_THRESHOLD=5
SPIKE_WINDOW_MINUTES=60
